# Trading Card Content Generator - Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to version control (it contains secrets)!

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Neon PostgreSQL Connection String
# Obtain from: Neon Dashboard -> Project -> Connection Details
NEON_CONNECTION_STRING=postgresql://user:password@host.neon.tech/dbname?sslmode=require&channel_binding=require
NEON_API_KEY=your_neon_api_key_here

# ============================================================================
# KIRO POWER CONFIGURATION
# ============================================================================

# Kiro Power name for Neon database integration
KIRO_POWER_NAME=neon

# ============================================================================
# GOOGLE DRIVE CONFIGURATION
# ============================================================================

# Google Drive query setup
GOOGLE_DRIVE_ROOT_FOLDER=TCG Articles
GOOGLE_DRIVE_CREDENTIALS_FILE=credentials.json
GOOGLE_DRIVE_TOKEN_FILE=token.json
GOOGLE_DRIVE_ENABLED=true

# ============================================================================
# AI API CONFIGURATION
# ============================================================================

# OpenAI API Key
# Obtain from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Anthropic API Key (Optional fallback)
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini API Key (Optional fallback)
GOOGLE_API_KEY=AIza...

# LLM Provider Configuration
LLM_PROVIDER=openai
ANTHROPIC_MODEL=claude-3-haiku-20240307
GEMINI_MODEL=gemini-2.0-flash

# ============================================================================
# SEO AND WEB SCRAPING CONFIGURATION
# ============================================================================

# Serper.dev API Key
# Obtain from: https://serper.dev/dashboard
# Required for: Finding new topics and articles
SERPER_API_KEY=your_serper_api_key_here

# ============================================================================
# TOPIC DISTRIBUTION CONFIGURATION
# ============================================================================

# Default number of topics to generate per run per category
DEFAULT_POKEMON_COUNT=5
DEFAULT_HOCKEY_COUNT=3
DEFAULT_SOCCER_COUNT=2

# ============================================================================
# SYSTEM CONFIGURATION
# ============================================================================

MAX_RETRIES=3
LOGGING_LEVEL=INFO
PYLINT_MIN_SCORE=8.0

# ============================================================================
# STREAMLIT CONFIGURATION
# ============================================================================

STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=false
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
